                    "id": "3005037f-495f-4c1e-879a-f632c2d688c7",
                    "leftValue": "={{ $json.output[0].content[0].text.trim() }}",
                    "rightValue": "=AUTO_REPLY",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Auto Reply"
            },
