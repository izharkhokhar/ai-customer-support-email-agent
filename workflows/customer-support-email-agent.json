                    "leftValue": "={{ $json.output[0].content[0].text.trim() }}",
                    "rightValue": "HUMAN_REVIEW",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Human Review"
            },
