                  "version": 3
                },
                "conditions": [
                  {
                    "id": "6aefa68c-799c-4f8b-9e3b-8620a8cbce5c",
                    "leftValue": "={{ $json.output[0].content[0].text.trim() }}",
                    "rightValue": "NOT_SUPPORT",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "name": "filter.operator.equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
